{
    "name": "mangaden",
    "version": "1.0.0",
    "private": true,
    "description": "A modern manga reading platform with independent frontend and backend deployment",
    "scripts": {
        "dev": "pnpm --parallel -r dev",
        "dev:backend": "pnpm --filter backend dev",
        "dev:frontend": "pnpm --filter frontend dev",
        "build": "pnpm --parallel -r build",
        "build:backend": "pnpm --filter backend build",
        "build:frontend": "pnpm --filter frontend build",
        "db:generate": "pnpm --filter backend db:generate",
        "db:migrate": "pnpm --filter backend db:migrate",
        "db:studio": "pnpm --filter backend db:studio",
        "db:seed": "pnpm --filter backend db:seed",
        "docker:build": "docker-compose -f docker-compose.yml build",
        "docker:up": "docker-compose -f docker-compose.yml up -d",
        "docker:down": "docker-compose -f docker-compose.yml down",
        "docker:logs": "docker-compose -f docker-compose.yml logs -f",
        "docker:restart": "docker-compose -f docker-compose.yml restart",
        "setup": "pnpm install && pnpm db:migrate"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ]
    },
    "devDependencies": {
        "typescript": "^5.3.3"
    }
}
