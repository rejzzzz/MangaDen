{
    "name": "mangaden",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "pnpm --parallel --filter \"@mangaden/*\" dev",
        "dev:api": "pnpm --filter @mangaden/api dev",
        "dev:web": "pnpm --filter @mangaden/web dev",
        "build": "pnpm --parallel --filter \"@mangaden/*\" build",
        "build:api": "pnpm --filter @mangaden/api build",
        "build:web": "pnpm --filter @mangaden/web build",
        "db:generate": "pnpm --filter @mangaden/api db:generate",
        "db:migrate": "pnpm --filter @mangaden/api db:migrate",
        "db:studio": "pnpm --filter @mangaden/api db:studio",
        "db:seed": "pnpm --filter @mangaden/api db:seed",
        "docker:build": "docker-compose build",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "docker:restart": "docker-compose restart",
        "setup": "pnpm install && pnpm db:migrate"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ]
    },
    "devDependencies": {
        "typescript": "^5.3.3"
    }
}
