---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import MangaCard from "../components/MangaCard.astro";
import { api } from "../lib/api";

// Fetch manga from API
let popularManga: any[] = [];
let latestManga: any[] = [];
let error: string | null = null;

try {
  const [popularRes, latestRes] = await Promise.all([
    api.getManga({ limit: 8 }),
    api.getManga({ limit: 8, page: 1 }),
  ]);
  
  if (popularRes.success && popularRes.data) {
    popularManga = popularRes.data;
  }
  if (latestRes.success && latestRes.data) {
    // Sort by createdAt for latest
    latestManga = [...latestRes.data].sort((a, b) => 
      new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
    );
  }
} catch (e) {
  console.error("Failed to fetch manga:", e);
  error = "Failed to load manga. Is the API running?";
}
---

<BaseLayout title="Home">
  <Navbar />
  <main>
    <Hero />
    
    {error && (
      <section class="section">
        <div class="container">
          <div class="error-banner">
            <p>⚠️ {error}</p>
            <p class="error-hint">Make sure to run: <code>pnpm dev:api</code></p>
          </div>
        </div>
      </section>
    )}
    
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            <span class="gradient-text">Popular</span> Right Now
          </h2>
          <a href="/browse" class="view-all">View All →</a>
        </div>
        
        {popularManga.length > 0 ? (
          <div class="manga-grid">
            {popularManga.map((manga) => (
              <MangaCard 
                slug={manga.slug}
                title={manga.title}
                coverUrl={manga.coverUrl || "https://placehold.co/300x400/1a1a24/8b5cf6?text=No+Cover"}
                type={manga.type}
                status={manga.status}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No manga found. Run <code>pnpm db:seed</code> to add sample data.</p>
          </div>
        )}
      </div>
    </section>
    
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            <span class="gradient-text">Latest</span> Updates
          </h2>
          <a href="/latest" class="view-all">View All →</a>
        </div>
        
        {latestManga.length > 0 ? (
          <div class="manga-grid">
            {latestManga.map((manga) => (
              <MangaCard 
                slug={manga.slug}
                title={manga.title}
                coverUrl={manga.coverUrl || "https://placehold.co/300x400/1a1a24/8b5cf6?text=No+Cover"}
                type={manga.type}
                status={manga.status}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No manga found.</p>
          </div>
        )}
      </div>
    </section>
  </main>
  
  <footer class="footer">
    <div class="container">
      <p>© 2024 MangaDen. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  main {
    min-height: 100vh;
  }
  
  .section {
    padding: 3rem 0;
  }
  
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
  }
  
  .view-all {
    color: var(--color-accent);
    font-weight: 500;
    transition: color var(--transition-fast);
  }
  
  .view-all:hover {
    color: var(--color-accent-hover);
  }
  
  .manga-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .manga-grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    }
  }
  
  .error-banner {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-lg);
    padding: 1rem 1.5rem;
    text-align: center;
  }
  
  .error-hint {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  
  .error-hint code {
    background: var(--color-bg-tertiary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
  }
  
  .empty-state code {
    background: var(--color-bg-tertiary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  
  .footer {
    margin-top: 4rem;
    padding: 2rem 0;
    padding-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: var(--color-text-muted);
  }
  
  @media (max-width: 768px) {
    .section {
      padding: 2rem 0;
    }
    
    .section-title {
      font-size: 1.25rem;
    }
    
    .view-all {
      font-size: 0.875rem;
    }
    
    .manga-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.75rem;
    }
    
    .empty-state {
      padding: 2rem;
    }
  }
</style>
