{
    "name": "backend",
    "version": "1.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "esbuild ./src/vercel.ts --bundle --platform=node --target=node20 --format=esm --outfile=./api/index.js --external:dotenv",
        "build:node": "node build.js",
        "start": "node api/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx src/db/seed.ts",
        "db:set-role": "tsx src/db/promote-user.ts",
        "test:connections": "tsx test-connections.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.8.0",
        "@hono/zod-validator": "^0.2.0",
        "@mangaden/shared": "workspace:*",
        "@supabase/supabase-js": "^2.95.3",
        "@types/sharp": "^0.32.0",
        "@upstash/redis": "^1.36.2",
        "@vercel/node": "^5.6.1",
        "cloudinary": "^2.9.0",
        "dotenv": "^16.3.0",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.0.0",
        "jsonwebtoken": "^9.0.3",
        "pdf-to-png-converter": "^4.1.0",
        "pdf2pic": "^3.2.0",
        "pdfjs-dist": "^5.6.205",
        "postgres": "^3.4.0",
        "sharp": "^0.34.5",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "drizzle-kit": "^0.31.8",
        "esbuild": "^0.27.3",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}
