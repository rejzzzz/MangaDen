{
    "buildCommand": "pnpm --filter @mangaden/api run build",
    "installCommand": "pnpm install --frozen-lockfile",
    "functions": {
        "apps/api/api/index.js": {
            "runtime": "@vercel/node@3"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/apps/api/api/index.js"
        }
    ]
}
