FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9 --activate

FROM base AS builder
WORKDIR /app

# Cache layer for pnpm fetch
COPY pnpm-lock.yaml ./
RUN pnpm fetch

# Copy full workspace and install offline
COPY . .
RUN pnpm install --frozen-lockfile --offline

# Build the backend
RUN pnpm --filter backend run build:node

# Deploy only production dependencies of backend to /app/out
RUN pnpm deploy --filter backend --prod /app/out

# Copy the built files into the deployed directory
RUN cp -r backend/dist /app/out/dist

FROM base AS runner
WORKDIR /app

# Copy the optimized production build from builder
COPY --from=builder /app/out .

EXPOSE 3000

# Alpine uses wget instead of curl by default
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health || exit 1

CMD ["node", "dist/index.js"]
