---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import ProfilePanel from "../components/ProfilePanel";
---

<BaseLayout title="Profile">
  <Navbar />
  <main class="main">
    <div class="container">
      <ProfilePanel client:load />
    </div>
  </main>
</BaseLayout>

<style>
  .main {
    min-height: 100vh;
    padding-top: 100px;
    background:
      radial-gradient(1200px 500px at 50% -80px, color-mix(in srgb, var(--color-accent) 24%, transparent), transparent 62%),
      var(--color-bg-primary);
  }

  .profile-card {
    max-width: 640px;
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 10%, transparent);
    border-radius: 20px;
    padding: 1.35rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
  }

  :global(.profile-top) {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }

  :global(.avatar-wrap) {
    width: 90px;
    height: 90px;
    border-radius: 9999px;
    overflow: hidden;
    border: 3px solid color-mix(in srgb, var(--color-accent) 62%, transparent);
    flex: 0 0 auto;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  :global(.avatar) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.profile-head h1) {
    font-size: 1.45rem;
    line-height: 1.15;
    margin-bottom: 0.25rem;
  }

  :global(.upload-card) {
    background: color-mix(in srgb, var(--color-bg-tertiary) 76%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 10%, transparent);
    border-radius: 14px;
    padding: 0.9rem;
    margin-bottom: 0.9rem;
  }

  :global(.upload-title) {
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  :global(.upload-help) {
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    margin-bottom: 0.7rem;
  }

  :global(.upload-row) {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    flex-wrap: wrap;
  }

  :global(.file-input) {
    color: var(--color-text-secondary);
    max-width: 100%;
    font-size: 0.9rem;
  }

  :global(.upload-btn) {
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.62rem 0.95rem;
    font-weight: 600;
    min-height: 42px;
  }

  :global(.upload-btn:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  :global(.success) {
    color: #22c55e;
    margin-bottom: 0.75rem;
  }

  :global(.error) {
    color: #ef4444;
    margin-bottom: 0.75rem;
  }

  h1 {
    margin-bottom: 0.25rem;
  }

  .muted {
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.88rem 0.95rem;
  }

  :global(.info-row) {
    background: color-mix(in srgb, var(--color-bg-tertiary) 62%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 8%, transparent);
    border-radius: 12px;
    margin-top: 0.55rem;
  }

  .label {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  :global(.value) {
    font-weight: 600;
    text-align: right;
    max-width: 60%;
    overflow-wrap: anywhere;
  }

  .go-home {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .main {
      padding-top: 86px;
    }

    .profile-card {
      border-radius: 16px;
      padding: 1rem;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
    }

    :global(.profile-top) {
      align-items: center;
      gap: 0.75rem;
    }

    :global(.avatar-wrap) {
      width: 76px;
      height: 76px;
      border-width: 2px;
    }

    :global(.profile-head h1) {
      font-size: 1.2rem;
    }

    :global(.upload-card) {
      padding: 0.8rem;
    }

    :global(.upload-row) {
      flex-direction: column;
      align-items: stretch;
    }

    :global(.file-input) {
      width: 100%;
      max-width: none;
    }

    :global(.upload-btn) {
      width: 100%;
    }

    .row {
      padding: 0.78rem 0.85rem;
    }

    :global(.value) {
      max-width: 58%;
      font-size: 0.92rem;
    }
  }
</style>
