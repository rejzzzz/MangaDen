---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import TrendingContent from "../components/TrendingContent";
import { api, type TrendingResult } from "../lib/api";

// Fetch initial trending data (7 days)
let initialData: TrendingResult | null = null;
let error: string | null = null;

try {
  const res = await api.getTrending({
    period: "7d",
    limit: 24,
    offset: 0,
  });

  if (res.success && res.data) {
    initialData = res.data;
  } else {
    error = res.error || "Failed to load trending manga";
  }
} catch (e) {
  console.error("Failed to fetch trending:", e);
  error = "Failed to load trending manga";
}
---

<BaseLayout title="Trending Manga">
  <Navbar />

  <main class="main">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">
          <span class="gradient-text">🔥 Trending</span> Manga
        </h1>
        <p class="page-subtitle">Most popular manga based on views, bookmarks, ratings, and comments</p>
      </header>

      <TrendingContent client:load initialData={initialData} initialError={error} />
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <p>© 2024 MangaDen. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .main {
    min-height: 100vh;
    padding-top: 80px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
  }

  .gradient-text {
    background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .footer {
    margin-top: 4rem;
    padding: 2rem 0;
    padding-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .main {
      padding-top: 60px;
      padding-bottom: 2rem;
    }

    .page-header {
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-size: 1.75rem;
    }

    .page-subtitle {
      font-size: 0.875rem;
    }
  }
</style>
