---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import MangaCard from "../components/MangaCard.astro";
import { api } from "../lib/api";

// Get query params
const url = new URL(Astro.request.url);
const type = url.searchParams.get("type");
const status = url.searchParams.get("status");
const page = parseInt(url.searchParams.get("page") || "1");

// Fetch manga with filters
let mangaList: any[] = [];
let error: string | null = null;

try {
  const res = await api.getManga({ 
    page, 
    limit: 24,
    type: type || undefined,
    status: status || undefined,
  });
  
  if (res.success && res.data) {
    mangaList = res.data;
  }
} catch (e) {
  console.error("Failed to fetch manga:", e);
  error = "Failed to load manga";
}

const types = ["manga", "manhwa", "manhua", "webtoon"];
const statuses = ["ongoing", "completed", "hiatus"];
---

<BaseLayout title="Browse">
  <Navbar />
  
  <main class="main">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">
          <span class="gradient-text">Browse</span> Manga
        </h1>
        <p class="page-subtitle">Discover your next favorite read</p>
      </header>
      
      {/* Filters */}
      <div class="filters">
        <div class="filter-group">
          <label>Type</label>
          <div class="filter-options">
            <a href="/browse" class:list={["filter-btn", { active: !type }]}>All</a>
            {types.map((t) => (
              <a 
                href={`/browse?type=${t}${status ? `&status=${status}` : ""}`} 
                class:list={["filter-btn", { active: type === t }]}
              >
                {t}
              </a>
            ))}
          </div>
        </div>
        
        <div class="filter-group">
          <label>Status</label>
          <div class="filter-options">
            <a href={`/browse${type ? `?type=${type}` : ""}`} class:list={["filter-btn", { active: !status }]}>All</a>
            {statuses.map((s) => (
              <a 
                href={`/browse?${type ? `type=${type}&` : ""}status=${s}`} 
                class:list={["filter-btn", { active: status === s }]}
              >
                {s}
              </a>
            ))}
          </div>
        </div>
      </div>
      
      {/* Results */}
      {error ? (
        <div class="error-banner">
          <p>⚠️ {error}</p>
        </div>
      ) : mangaList.length > 0 ? (
        <div class="manga-grid">
          {mangaList.map((manga) => (
            <MangaCard
              slug={manga.slug}
              title={manga.title}
              coverUrl={manga.coverUrl || "https://placehold.co/300x400/1a1a24/8b5cf6?text=No+Cover"}
              type={manga.type}
              status={manga.status}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>No manga found matching your filters.</p>
          <a href="/browse" class="reset-link">Reset filters</a>
        </div>
      )}
    </div>
  </main>
  
  <footer class="footer">
    <div class="container">
      <p>© 2024 MangaDen. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .main {
    min-height: 100vh;
    padding-top: 80px;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
  }
  
  .page-subtitle {
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }
  
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
  }
  
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .filter-group label {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .filter-btn {
    padding: 0.5rem 1rem;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    text-transform: capitalize;
    transition: all 0.2s;
  }
  
  .filter-btn:hover {
    background: rgba(139, 92, 246, 0.2);
  }
  
  .filter-btn.active {
    background: var(--gradient-primary);
    color: white;
    font-weight: 600;
  }
  
  .manga-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .manga-grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    }
  }
  
  .error-banner {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-lg);
    padding: 1rem 1.5rem;
    text-align: center;
  }
  
  .empty-state {
    text-align: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }
  
  .reset-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent);
  }
  
  .footer {
    margin-top: 4rem;
    padding: 2rem 0;
    padding-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: var(--color-text-muted);
  }
  
  @media (max-width: 768px) {
    .main {
      padding-top: 60px;
      padding-bottom: 2rem;
    }
    
    .page-title {
      font-size: 1.75rem;
    }
    
    .filters {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }
    
    .filter-group {
      gap: 0.5rem;
    }
    
    .filter-options {
      gap: 0.375rem;
    }
    
    .filter-btn {
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
    }
    
    .manga-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.75rem;
    }
    
    .empty-state {
      padding: 2rem;
    }
  }
</style>
